PROJECT_NAME = "OpenArm SmolVLA"
PROJECT_BRIEF = "Training, deployment and guarded control for OpenArm"
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/site"
INPUT = "@REPO_ROOT@/README.md" "@REPO_ROOT@/docs" "@REPO_ROOT@/include"
FILE_PATTERNS = *.md *.hpp
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = "@REPO_ROOT@/README.md"
EXTRACT_ALL = YES
MARKDOWN_SUPPORT = YES
MARKDOWN_ID_STYLE = GITHUB
TOC_INCLUDE_HEADINGS = 3
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_NO_PARAMDOC = NO
WARN_AS_ERROR = YES
GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_TREEVIEW = YES
HTML_COLORSTYLE = AUTO_LIGHT
GENERATE_LATEX = NO
HAVE_DOT = NO
